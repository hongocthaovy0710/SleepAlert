<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

    <!-- Nút back -->
    <ImageView
            android:id="@+id/btnBackHistory"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            app:srcCompat="@drawable/ic_back"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề -->
    <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lịch sử cảnh báo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingEnd="24dp"
            app:layout_constraintStart_toEndOf="@id/btnBackHistory"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBackHistory"
            app:layout_constraintBottom_toBottomOf="@id/btnBackHistory"
            android:layout_marginTop="50dp" />

    <!-- Subtitle -->
    <TextView
            android:id="@+id/tvHistorySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:text="Trong 3 ngày gần đây"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nội dung: ScrollView chứa vài card fake -->
    <ScrollView
            android:id="@+id/scrollHistory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvHistorySubtitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Card 1: Mức CAO -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                    <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="💤"
                            android:textSize="24sp"
                            android:gravity="center" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cảnh báo mức CAO"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#D32F2F" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24/11/2025 · 19:30 · 15 giây"
                                android:textSize="13sp"
                                android:textColor="#757575"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/btnView1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem"
                            android:textSize="14sp"
                            android:textColor="#1E88E5"
                            android:padding="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                    <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="😴"
                            android:textSize="24sp"
                            android:gravity="center" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cảnh báo mức TRUNG BÌNH"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F9A825" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24/11/2025 · 18:10 · 10 giây"
                                android:textSize="13sp"
                                android:textColor="#757575"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/btnView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem"
                            android:textSize="14sp"
                            android:textColor="#1E88E5"
                            android:padding="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                    <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="🙂"
                            android:textSize="24sp"
                            android:gravity="center" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhắc nhở nhẹ"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#388E3C" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="23/11/2025 · 21:05 · 8 giây"
                                android:textSize="13sp"
                                android:textColor="#757575"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/btnView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xem"
                            android:textSize="14sp"
                            android:textColor="#1E88E5"
                            android:padding="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
