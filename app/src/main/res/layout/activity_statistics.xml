<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white">

    <!-- Nút back -->
    <ImageView
            android:id="@+id/btnBackStats"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            app:srcCompat="@drawable/ic_back"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề -->
    <TextView
            android:id="@+id/tvStatsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Thống kê cảnh báo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingEnd="24dp"
            app:layout_constraintStart_toEndOf="@id/btnBackStats"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBackStats"
            app:layout_constraintBottom_toBottomOf="@id/btnBackStats"
            android:layout_marginTop="50dp" />

    <!-- Subtitle -->
    <TextView
            android:id="@+id/tvStatsSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:text="Trong 7 ngày gần đây"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintTop_toBottomOf="@id/tvStatsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nội dung -->
    <ScrollView
            android:id="@+id/scrollStats"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatsSubtitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Card: Tổng quan -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng quan"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />

                    <TextView
                            android:id="@+id/tvTotalAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Tổng cảnh báo: 0"
                            android:textSize="14sp"
                            android:textColor="#424242" />

                    <TextView
                            android:id="@+id/tvTodayAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hôm nay: 0"
                            android:textSize="14sp"
                            android:textColor="#424242" />

                    <TextView
                            android:id="@+id/tvLongestAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Cảnh báo dài nhất: 0 giây"
                            android:textSize="14sp"
                            android:textColor="#424242" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Mức độ buồn ngủ -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theo mức độ buồn ngủ"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />

                    <!-- Cao -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💤 Cao"
                                android:textSize="14sp"
                                android:textColor="#D32F2F" />

                        <ProgressBar
                                android:id="@+id/pbHigh"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="10dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:max="100" />

                        <TextView
                                android:id="@+id/tvHighCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#424242" />
                    </LinearLayout>

                    <!-- Trung bình -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😴 Trung bình"
                                android:textSize="14sp"
                                android:textColor="#F9A825" />

                        <ProgressBar
                                android:id="@+id/pbMedium"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="10dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:max="100" />

                        <TextView
                                android:id="@+id/tvMediumCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#424242" />
                    </LinearLayout>

                    <!-- Thấp -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🙂 Thấp"
                                android:textSize="14sp"
                                android:textColor="#388E3C" />

                        <ProgressBar
                                android:id="@+id/pbLow"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="0dp"
                                android:layout_height="10dp"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:max="100" />

                        <TextView
                                android:id="@+id/tvLowCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="0"
                                android:textSize="14sp"
                                android:textColor="#424242" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Gợi ý -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:id="@+id/tvTips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gợi ý an toàn sẽ hiện ở đây tuỳ theo thống kê."
                            android:textSize="14sp"
                            android:textColor="#424242" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
